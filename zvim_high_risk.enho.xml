    <PROGRAMNAME>/OTX/PF01_CL_MODULE_CC_VALIDA=CP</PROGRAMNAME>
   </ORIGINAL_OBJECT>
   <ENHANCEMENTS>
    <ENH_HOOK_IMPL>
     <PROGRAMNAME>/OTX/PF01_CL_MODULE_CC_VALIDA=CP</PROGRAMNAME>
     <EXTID>1</EXTID>
     <ID>1</ID>
     <ENHMODE>D</ENHMODE>
     <FULL_NAME>\TY:/OTX/PF01_CL_MODULE_CC_VALIDA\IN:/OTX/PF01_IF_MODULE\ME:PROCESS_MODULE\SE:END\EI</FULL_NAME>
     <SOURCE>
      <item>DATA: lt_full_txt TYPE /otx/pf11_tt_fulltext_str.</item>
      <item>DATA : lv_company_code TYPE bukrs.</item>
      <item>DATA : ls_reg_dext_temp TYPE /otx/pf11_t_dext.</item>
      <item>DATA: lv_id TYPE /OTX/PF11_E_EXT_ELEMENT_ID.</item>
      <item>DATA ls_otx_pf01_t_1ext TYPE /otx/pf01_t_1ext.</item>
      <item>DATA : ls_reg_dext TYPE /otx/pf11_t_dext .</item>
      <item>DATA : ls_1reg TYPE /OTX/PF01_T_1REG.</item>
      <item/>
      <item>SELECT SINGLE docid FROM /opt/vim_1head INTO @data(lv_docid) WHERE reg_id = @pes_1reg-regid.</item>
      <item>SELECT * FROM /otx/pf11_t_dext INTO TABLE @DATA(lt_reg_dext) WHERE regid =  @pes_1reg-regid.</item>
      <item/>
      <item>TRY.</item>
      <item>TRY.</item>
      <item>CALL METHOD /otx/ps03_cl_ies_util=&gt;get_fulltext</item>
      <item>EXPORTING</item>
      <item>pi_regid     = pes_1reg-regid</item>
      <item>pi_docid     = lv_docid</item>
      <item>IMPORTING</item>
      <item>pet_fulltext = lt_full_txt .</item>
      <item/>
      <item>ENDTRY.</item>
      <item/>
      <item>IF lt_full_txt[] IS NOT INITIAL.</item>
      <item>DATA(lv_found) = abap_false.</item>
      <item>LOOP AT lt_full_txt INTO DATA(ls_full_txt).</item>
      <item>TRANSLATE ls_full_txt-fulltext TO UPPER CASE.</item>
      <item>IF ls_full_txt-fulltext CS &apos;GOVERNMENT&apos;.</item>
      <item>lv_found = abap_true.</item>
      <item>DELETE FROM /OTX/PF11_T_FULL where regid = pes_1reg-regid</item>
      <item>and page_number = ls_full_txt-page_number.</item>
      <item/>
      <item>EXIT.</item>
      <item>ENDIF.</item>
      <item>ENDLOOP.</item>
      <item/>
      <item>IF lv_found = abap_true.</item>
      <item>CLEAR ls_reg_dext.</item>
      <item>CLEAR ls_reg_dext-value.</item>
      <item>READ TABLE lt_reg_dext INTO ls_reg_dext WITH KEY  regid = pes_1reg-regid</item>
      <item>name = &apos;Z_Z_HIGHRISK&apos;.</item>
      <item>IF sy-subrc = 0.</item>
      <item>ls_reg_dext-value = &apos;X&apos;.</item>
      <item>ls_reg_dext-raw_value = &apos;X&apos;.</item>
      <item>ls_reg_dext-value_found = &apos;true&apos;.</item>
      <item>UPDATE /otx/pf11_t_dext FROM ls_reg_dext.</item>
      <item>ENDIF.</item>
      <item/>
      <item>ENDIF.</item>
      <item/>
      <item>ENDIF.</item>
      <item/>
      <item>ENDTRY.</item>
     </SOURCE>
